PROJECT_NAME=Mission Control
ENVIRONMENT=production
EDITION=community

# ---------------------------------------------------------------
# Security
# ---------------------------------------------------------------
# Production must use a strong, unique Fernet key.
MISSIONCONTROL_SECRET_KEY=CHANGE_ME_PRODUCTION

# ---------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------
POSTGRES_DB=missioncontrol_live
POSTGRES_USER=missioncontrol_live
POSTGRES_PASSWORD=CHANGE_ME_LIVE_DB
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------------------------------------------------------------
# Redis
# ---------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ---------------------------------------------------------------
# Backend
# ---------------------------------------------------------------
BACKEND_CORS_ORIGINS=https://missioncontrol.optihosting.co.za

# ---------------------------------------------------------------
# Docker Compose
# ---------------------------------------------------------------
COMPOSE_PROJECT_NAME=missioncontrol-live

# ---------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------
# AD_SERVER=
# AD_PORT=636
# AD_USE_SSL=true
# AD_USERNAME=
# AD_PASSWORD=
# AD_BASE_DN=
#
# M365_TENANT_ID=
# M365_CLIENT_ID=
# M365_CLIENT_SECRET=
#
# ZABBIX_URL=
# ZABBIX_USERNAME=
# ZABBIX_PASSWORD=
# ZABBIX_VERIFY_SSL=true
# ZABBIX_TIMEOUT=30
# ZABBIX_RETRIES=3
