PROJECT_NAME=Mission Control
ENVIRONMENT=development
EDITION=community

# ---------------------------------------------------------------
# Security
# ---------------------------------------------------------------
# Generate a Fernet key (required -- the stack will not start without it):
#
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Paste the generated key below (replace the entire line):
MISSIONCONTROL_SECRET_KEY=CHANGE_ME

# ---------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------
POSTGRES_DB=mission_control
POSTGRES_USER=mission_control
POSTGRES_PASSWORD=mission_control
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------------------------------------------------------------
# Redis
# ---------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ---------------------------------------------------------------
# Backend
# ---------------------------------------------------------------
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------
# Remote Operations (optional)
# ---------------------------------------------------------------
# SSH_DEFAULT_USERNAME=ubuntu
# SSH_DEFAULT_PORT=22
# WINRM_DEFAULT_PORT=5985

# ---------------------------------------------------------------
# Active Directory (optional)
# ---------------------------------------------------------------
# AD_SERVER=ldap://your-ad-server
# AD_PORT=636
# AD_USE_SSL=true
# AD_USERNAME=ad_user
# AD_PASSWORD=ad_password
# AD_BASE_DN=DC=corp,DC=contoso,DC=com

# ---------------------------------------------------------------
# Microsoft 365 (optional)
# ---------------------------------------------------------------
# M365_TENANT_ID=your-tenant-id
# M365_CLIENT_ID=your-client-id
# M365_CLIENT_SECRET=your-client-secret

# ---------------------------------------------------------------
# Zabbix (optional)
# ---------------------------------------------------------------
# ZABBIX_URL=https://zabbix.example.com
# ZABBIX_USERNAME=Admin
# ZABBIX_PASSWORD=zabbix
# ZABBIX_VERIFY_SSL=true
# ZABBIX_TIMEOUT=30
# ZABBIX_RETRIES=3

# ---------------------------------------------------------------
# Docker
# ---------------------------------------------------------------
COMPOSE_PROJECT_NAME=missioncontrol
