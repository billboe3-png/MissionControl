# Mission Control — BACKEND VM environment template (Phase 3 artefact)
#
# Copy to /opt/missioncontrol/.env on the backend VM and fill in the values.
# NEVER commit the filled-in file. Mode must be 600, owner ubuntu.
#
# The MISSIONCONTROL_SECRET_KEY value MUST be byte-identical to production:
# it is the Fernet key that decrypts 33 stored credentials (16/16
# agent_remote_targets, 15/15 veeam_backup_servers, 2/6 integration_profiles).
# A different *valid* key does not fail a restore -- it fails silently at first
# use of each integration. Verify by decrypting one credential after restore.
#
# Transfer with scp/rsync over SSH only. Never paste the value into a ticket,
# chat, log or command line that gets recorded.

# --- application ---
MISSIONCONTROL_SECRET_KEY=__COPY_FROM_SOURCE_ENV__

# --- database ---
POSTGRES_DB=mission_control
POSTGRES_USER=mission_control
POSTGRES_PASSWORD=__COPY_FROM_SOURCE_ENV__
# Inside compose, service names resolve through Docker's embedded DNS.
# Do NOT copy the source /etc/hosts 127.0.0.1 pins.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- http ---
BACKEND_CORS_ORIGINS=https://missioncontrol.optichosting.co.za

# --- notes ---
# DOCKERHAND_SECRET is intentionally absent: Dockhand is not migrated (D-B/U5).
# MISSIONCONTROL_SECRET_KEY is defined here only; the source host also defines it
# inline in compose, which is a duplicate source of truth and is not carried over.
