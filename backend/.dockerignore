# Mission Control - Backend Docker Ignore
# Exclude everything that shouldn't be in the build context

# Version control
.git
.gitignore

# Python
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.egg-info
*.egg
dist
build
.eggs

# Virtual environments
venv
.venv
env

# Testing
.pytest_cache
htmlcov
.coverage
.coverage.*
coverage.xml

# IDE
.vscode
.idea
*.swp
*.swo
*~

# Environment files (secrets)
.env
.env.*
!.env.example

# Docker
docker-compose*.yml
Dockerfile*

# Documentation
*.md
LICENSE

# OS files
.DS_Store
Thumbs.db

# Test files (not needed in production image)
tests/
**/test_*.py
**/*_test.py
