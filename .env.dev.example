PROJECT_NAME=Mission Control
ENVIRONMENT=development
EDITION=community

# ---------------------------------------------------------------
# Security
# ---------------------------------------------------------------
# Generate a Fernet key (required -- the stack will not start without it):
#
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Paste the generated key below (replace the entire line):
MISSIONCONTROL_SECRET_KEY=CHANGE_ME_DEV

# ---------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------
POSTGRES_DB=missioncontrol_dev
POSTGRES_USER=missioncontrol_dev
POSTGRES_PASSWORD=CHANGE_ME_DEV_DB
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------------------------------------------------------------
# Redis
# ---------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ---------------------------------------------------------------
# Backend
# ---------------------------------------------------------------
BACKEND_CORS_ORIGINS=https://missioncontroldev.optichosting.co.za,http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------
# Docker Compose
# ---------------------------------------------------------------
COMPOSE_PROJECT_NAME=missioncontrol-dev

# ---------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------
# AD_SERVER=
# AD_PORT=636
# AD_USE_SSL=true
# AD_USERNAME=
# AD_PASSWORD=
# AD_BASE_DN=
#
# M365_TENANT_ID=
# M365_CLIENT_ID=
# M365_CLIENT_SECRET=
#
# ZABBIX_URL=
# ZABBIX_USERNAME=
# ZABBIX_PASSWORD=
# ZABBIX_VERIFY_SSL=true
# ZABBIX_TIMEOUT=30
# ZABBIX_RETRIES=3
